# needed for Python extension

# NOTE: in order for paths in this .env file to work, one needs to add
# the following entries to the launch config:
# ```
#   "envFile": "${workspaceFolder}/.env",
#   "env": {
#       "WORKSPACE_FOLDER": "${workspaceFolder}"
#   },
# ```

PYTHONPATH="${PYTHONPATH}:src/lib/python"
PYTHONPATH="${PYTHONPATH}:src/service"
PYTHONPATH="${PYTHONPATH}:src/web"
PYTHONPATH="${PYTHONPATH}:src/tests"

PYTHONPATH="${PYTHONPATH}:${WORKSPACE_FOLDER}/src/lib/python"
PYTHONPATH="${PYTHONPATH}:${WORKSPACE_FOLDER}/src/service"
PYTHONPATH="${PYTHONPATH}:${WORKSPACE_FOLDER}/src/web"
PYTHONPATH="${PYTHONPATH}:${WORKSPACE_FOLDER}/src/tests"